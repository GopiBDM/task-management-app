# Your local PostgreSQL (the same server you open in pgAdmin).
# If your password has special characters (@ : / #), URL-encode them.
DATABASE_URL=postgresql://postgres:STFTYWFzQDUh@localhost:5432/opstrack

# A long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-the-generated-value-here

# Set to true only when the app is served over https
COOKIE_SECURE=false

